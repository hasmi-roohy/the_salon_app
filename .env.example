# Development database behavior. Never enable synchronization in production.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# MongoDB is currently optional and is not required for virtual try-on.
MONGO_ENABLED=false
MONGO_URI=mongodb://localhost:27017/salon_ai_logs

# Premium AI image try-on provider.
# Keep real provider keys only on the NestJS backend, never in Flutter.
# Development default is mock, because reliable realistic image editing usually costs.
AI_TRYON_PROVIDER=mock
AI_TRYON_MOCK_ENABLED=true

# Development-only payment entitlement simulation. Keep false in production.
PREMIUM_PAYMENT_MOCK_ENABLED=true

# Optional production/dev provider.
# fal.ai is pay-per-use. Nano Banana is used through fal.ai for premium AI edits.
FAL_KEY=
